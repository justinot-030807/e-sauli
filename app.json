{
  "expo": {
    "name": "E-Sauli Lost & Found",
    "slug": "esauli-lost-and-found",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "esauli-lf",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.esauli.lostandfound"
    },
    "android": {
      "package": "com.esauli.lostandfound",
      "adaptiveIcon": {
        "backgroundColor": "#7a1f2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "experiments": {
      "inlineModules": {
        "watchedDirectories": []
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
