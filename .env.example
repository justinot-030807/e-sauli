# Client-side (exposed to the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — NEVER prefix with EXPO_PUBLIC_
# These go in Supabase Dashboard > Settings > Edge Functions > Secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ITEM_HMAC_SECRET=your-hmac-secret-at-least-32-chars
